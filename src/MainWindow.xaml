<Window x:Class="MyFileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My File Manager"
        Width="1100"
        Height="700"
        MinWidth="700"
        MinHeight="450">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0">

                <Button x:Name="BackButton"
                        Content="←"
                        Width="40"
                        Height="32"
                        Click="BackButton_Click"
                        Margin="0,0,5,0"/>

                <Button Content="↑"
                        Width="40"
                        Height="32"
                        Click="UpButton_Click"
                        Margin="0,0,5,0"/>

                <Button Content="⟳"
                        Width="40"
                        Height="32"
                        Click="RefreshButton_Click"
                        Margin="0,0,10,0"/>

                <TextBox x:Name="PathBox"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="14"
                         KeyDown="PathBox_KeyDown"/>

            </StackPanel>
        </Border>

        <!-- Column headers -->
        <Grid Grid.Row="1"
              Background="#F5F5F5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Name"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Column="1"
                       Text="Type"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Column="2"
                       Text="Size"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Column="3"
                       Text="Modified"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Grid>

        <!-- File list -->
        <ListView x:Name="FileList"
                  Grid.Row="2"
                  MouseDoubleClick="FileList_MouseDoubleClick"
                  BorderThickness="0">

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="Name"
                                    Width="450"
                                    DisplayMemberBinding="{Binding Name}"/>

                    <GridViewColumn Header="Type"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Type}"/>

                    <GridViewColumn Header="Size"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Size}"/>

                    <GridViewColumn Header="Modified"
                                    Width="180"
                                    DisplayMemberBinding="{Binding Modified}"/>

                </GridView>
            </ListView.View>

        </ListView>

    </Grid>
</Window>
